{
  "name": "canli-quiz",
  "private": true,
  "type": "module",
  "description": "Gerçek zamanlı, çok oyunculu quiz platformu",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w @canli-quiz/server\" \"npm run dev -w @canli-quiz/web\"",
    "dev:server": "npm run dev -w @canli-quiz/server",
    "dev:web": "npm run dev -w @canli-quiz/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
