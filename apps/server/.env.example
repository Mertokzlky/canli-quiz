# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env asla GitHub'a yüklenmez.

PORT=4000

# Frontend'in adresi (CORS için). Birden fazlaysa virgülle ayırın.
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL bağlantısı. Ücretsiz seçenekler:
#  - `npm run db:start -w @canli-quiz/server` (npm paketiyle gelen yerel PostgreSQL 17, aşağıdaki adres;
#    `npm run dev` bunu kendisi başlatır)
#  - `docker compose up -d` -> postgresql://quiz:quiz@localhost:5432/canli_quiz
#  - Neon (neon.tech) ücretsiz katmanı
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/canli_quiz

# Oturum token'larını imzalamak için gizli anahtar (en az 32 karakter).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=bunu-degistirin-en-az-32-karakterlik-rastgele-bir-metin
